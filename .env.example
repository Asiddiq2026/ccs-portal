# ---------------------------------------------------------------------------
# CCS AR Oversight Platform — environment template. Copy to `.env` and fill in.
# Never commit the populated .env. The Anthropic key is server-side only.
# ---------------------------------------------------------------------------

# Postgres. The app connects as the non-superuser `ccs_app` role so that
# row-level security is enforced (see docker/postgres/init.sql). In local dev
# ccs_app owns the tables, so this connection also runs migrations + RLS.
DATABASE_URL="postgresql://ccs_app:ccs_app@localhost:5432/ccs?schema=public"

# PRODUCTION ONLY: connection for the table OWNER/admin role. Applying schema
# migrations and RLS (ENABLE/FORCE RLS, CREATE POLICY, REVOKE) needs ownership,
# which the runtime ccs_app role deliberately lacks. `npm run db:rls` uses this
# when set, else falls back to DATABASE_URL. Leave blank in dev.
RLS_DATABASE_URL=""

# --- Auth.js / OIDC SSO (Entra ID by default; swappable to Okta) -----------
AUTH_SECRET=""                 # openssl rand -base64 32
AUTH_URL="http://localhost:3000"   # canonical app URL (set to https:// in prod)
AUTH_ISSUER=""                 # OIDC issuer URL (Entra tenant or Okta org).
                               # Leave blank to disable SSO (e.g. local dev).
AUTH_CLIENT_ID=""              # role + arId are expected as mapped IdP claims
AUTH_CLIENT_SECRET=""

# Dev-only local login (bypasses SSO with fixed ar/compliance/smf users).
# HARD-GATED: ignored unless NODE_ENV !== "production". Never set in prod.
AUTH_DEV_LOGIN="true"

# --- Anthropic (SERVER ONLY — must never reach the browser bundle) ---------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"   # pin the FP AI-review model per environment

# --- WORM document storage (Azure Blob w/ immutability policy) -------------
# S3 + Object Lock is an acceptable substitute.
BLOB_ACCOUNT=""
BLOB_KEY=""
BLOB_CONTAINER="ccs-docs"      # immutability policy ON

# --- Training-completion ingest (service tokens) ---------------------------
# Machine-to-machine tokens the training platform uses to POST completions to
# /api/training/completions. Store only SHA-256 HASHES here, never raw tokens —
# generate a token, hash it (sha256 hex), give the raw token to the caller /
# vault, and record `arId:hash` entries below (comma/space separated). A token
# is scoped to exactly one AR. Empty = bearer ingest disabled (fails closed);
# operator import still works.
TRAINING_INGEST_TOKENS=""

# --- Agent runtime ---------------------------------------------------------
# Flip to true ONLY after Gate 5 (clean pilot quarter + executed DPA + pen
# test sign-off, each cleared in writing by SMF16/17). Per-environment.
AGENTS_AUTONOMOUS=false

# Set to true once SMF16/17 clear Gate 5 in writing. Surfaced by the monitoring
# snapshot as 5/5 gates cleared. Deploy-time control; audited on change.
GATE5_CLEARED=false
